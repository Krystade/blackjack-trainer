{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.scripts.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    /* Node for the fs/url access, vitest for the test globals this project
       also covers. */
    "types": ["node", "vite/client", "vitest/globals"],
    "skipLibCheck": true,
    "strict": true,

    /* Bundler resolution, because these files import app source directly and
       the app is written for a bundler (no ".js" extensions on TS imports). */
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "resolveJsonModule": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["scripts/**/*.ts"]
}
